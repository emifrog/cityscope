{
  "openapi": "3.1.0",
  "info": {
    "title": "etare-platform API",
    "version": "v1",
    "description": "API métier de la plateforme ETARE numérique. Toutes les réponses sont limitées au SIS actif et aux droits de l’appelant."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Jeton d’accès du fournisseur d’identité (Supabase Auth au MVP)."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "ok",
              "degraded"
            ]
          },
          "version": {
            "type": "string"
          },
          "checks": {
            "type": "object",
            "properties": {
              "database": {
                "type": "string",
                "enum": [
                  "ok",
                  "unavailable",
                  "skipped"
                ]
              }
            },
            "required": [
              "database"
            ]
          }
        },
        "required": [
          "status",
          "version",
          "checks"
        ]
      },
      "ApiError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "enum": [
                  "UNAUTHENTICATED",
                  "FORBIDDEN",
                  "MFA_REQUIRED",
                  "TENANT_REQUIRED",
                  "NOT_FOUND",
                  "VALIDATION_FAILED",
                  "CONFLICT",
                  "INVALID_TRANSITION",
                  "SELF_APPROVAL_FORBIDDEN",
                  "RATE_LIMITED",
                  "INTERNAL"
                ]
              },
              "message": {
                "type": "string"
              },
              "trace_id": {
                "type": "string"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "path",
                    "message"
                  ]
                }
              }
            },
            "required": [
              "code",
              "message",
              "trace_id"
            ]
          }
        },
        "required": [
          "error"
        ],
        "description": "Erreur structurée : code stable, message utile, trace_id, sans détail interne."
      },
      "Me": {
        "type": "object",
        "properties": {
          "user": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "email": {
                "type": "string"
              },
              "display_name": {
                "type": [
                  "string",
                  "null"
                ]
              }
            },
            "required": [
              "id",
              "email",
              "display_name"
            ]
          },
          "memberships": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Membership"
            }
          }
        },
        "required": [
          "user",
          "memberships"
        ]
      },
      "Membership": {
        "type": "object",
        "properties": {
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "tenant_slug": {
            "type": "string"
          },
          "tenant_name": {
            "type": "string"
          },
          "roles": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "SUPER_ADMIN",
                "SIS_ADMIN",
                "PREVISION_EDITOR",
                "PREVISION_VALIDATOR",
                "OPS_USER",
                "EXPLOITANT",
                "READER"
              ]
            }
          }
        },
        "required": [
          "tenant_id",
          "tenant_slug",
          "tenant_name",
          "roles"
        ]
      },
      "SiteList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/SiteSummary"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 512,
            "pattern": "^[A-Za-z0-9_-]+$"
          }
        },
        "required": [
          "items",
          "next_cursor"
        ]
      },
      "SiteSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "short_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "inactive",
              "archived"
            ]
          },
          "site_type": {
            "type": "string",
            "enum": [
              "erp",
              "industrial",
              "health",
              "education",
              "heritage",
              "other"
            ]
          },
          "sensitivity": {
            "type": "string",
            "enum": [
              "normal",
              "restricted",
              "high"
            ]
          },
          "etare_number": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 40
          },
          "address": {
            "$ref": "#/components/schemas/AddressSummary"
          },
          "location": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "Point"
                ]
              },
              "coordinates": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  }
                ]
              }
            },
            "required": [
              "type",
              "coordinates"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "tenant_id",
          "name",
          "short_name",
          "status",
          "site_type",
          "sensitivity",
          "etare_number",
          "address",
          "location",
          "updated_at"
        ],
        "description": "Site (données de travail), vue liste."
      },
      "AddressSummary": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "city": {
            "type": "string"
          },
          "postal_code": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "label",
          "city",
          "postal_code"
        ]
      },
      "SiteDetail": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "tenant_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "short_name": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "draft",
              "active",
              "inactive",
              "archived"
            ]
          },
          "site_type": {
            "type": "string",
            "enum": [
              "erp",
              "industrial",
              "health",
              "education",
              "heritage",
              "other"
            ]
          },
          "sensitivity": {
            "type": "string",
            "enum": [
              "normal",
              "restricted",
              "high"
            ]
          },
          "etare_number": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1,
            "maxLength": 40
          },
          "address": {
            "$ref": "#/components/schemas/AddressSummary"
          },
          "location": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "Point"
                ]
              },
              "coordinates": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number",
                    "minimum": -180,
                    "maximum": 180
                  },
                  {
                    "type": "number",
                    "minimum": -90,
                    "maximum": 90
                  }
                ]
              }
            },
            "required": [
              "type",
              "coordinates"
            ]
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "footprint": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "MultiPolygon"
                ]
              },
              "coordinates": {
                "type": "array",
                "items": {
                  "type": "array",
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "array",
                      "prefixItems": [
                        {
                          "type": "number",
                          "minimum": -180,
                          "maximum": 180
                        },
                        {
                          "type": "number",
                          "minimum": -90,
                          "maximum": 90
                        }
                      ]
                    },
                    "minItems": 4
                  },
                  "minItems": 1
                },
                "minItems": 1
              }
            },
            "required": [
              "type",
              "coordinates"
            ]
          },
          "last_verified_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "building_count": {
            "type": "integer",
            "minimum": 0
          },
          "active_publication": {
            "$ref": "#/components/schemas/ActivePublication"
          },
          "row_version": {
            "type": "integer",
            "exclusiveMinimum": 0
          }
        },
        "required": [
          "id",
          "tenant_id",
          "name",
          "short_name",
          "status",
          "site_type",
          "sensitivity",
          "etare_number",
          "address",
          "location",
          "updated_at",
          "footprint",
          "last_verified_at",
          "building_count",
          "active_publication",
          "row_version"
        ],
        "description": "Site (données de travail), vue détaillée."
      },
      "ActivePublication": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "publication_number": {
            "type": "integer",
            "exclusiveMinimum": 0
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "publication_number",
          "published_at"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "État du service",
        "tags": [
          "system"
        ],
        "security": [],
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          },
          "400": {
            "description": "Requête invalide (VALIDATION_FAILED, TENANT_REQUIRED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne (sans détail)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/me": {
      "get": {
        "operationId": "getMe",
        "summary": "Utilisateur connecté et SIS auxquels il appartient",
        "tags": [
          "identity"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Me"
                }
              }
            }
          },
          "400": {
            "description": "Requête invalide (VALIDATION_FAILED, TENANT_REQUIRED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Authentification requise",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Accès refusé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne (sans détail)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/sites": {
      "get": {
        "operationId": "listSites",
        "summary": "Sites du SIS actif (données de travail)",
        "tags": [
          "sites"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 512,
              "pattern": "^[A-Za-z0-9_-]+$"
            },
            "required": false,
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "SIS actif. Indication seulement : l’appartenance est revérifiée côté serveur."
            },
            "required": true,
            "description": "SIS actif. Indication seulement : l’appartenance est revérifiée côté serveur.",
            "name": "x-tenant-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteList"
                }
              }
            }
          },
          "400": {
            "description": "Requête invalide (VALIDATION_FAILED, TENANT_REQUIRED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Authentification requise",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Accès refusé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne (sans détail)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/sites/{id}": {
      "get": {
        "operationId": "getSite",
        "summary": "Détail d’un site du SIS actif",
        "tags": [
          "sites"
        ],
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "required": true,
            "name": "id",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "format": "uuid",
              "description": "SIS actif. Indication seulement : l’appartenance est revérifiée côté serveur."
            },
            "required": true,
            "description": "SIS actif. Indication seulement : l’appartenance est revérifiée côté serveur.",
            "name": "x-tenant-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Succès",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SiteDetail"
                }
              }
            }
          },
          "400": {
            "description": "Requête invalide (VALIDATION_FAILED, TENANT_REQUIRED)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "401": {
            "description": "Authentification requise",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "403": {
            "description": "Accès refusé",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "404": {
            "description": "Ressource introuvable ou non autorisée",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "500": {
            "description": "Erreur interne (sans détail)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
