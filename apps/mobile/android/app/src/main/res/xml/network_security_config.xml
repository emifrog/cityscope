<?xml version="1.0" encoding="utf-8"?>
<!-- Release / profile : HTTPS uniquement, certificats système uniquement
     (les autorités ajoutées par l'utilisateur ne sont pas approuvées). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
