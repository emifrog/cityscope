# Sauvegarde nocturne de la préproduction (EXP-02, ADR-031). Copier en sauvegarde.env sur le serveur
# (chmod 600). Mise en place : README.md, §10 ; exploitation : docs/exploitation/sauvegarde-restauration.md.

BACKUP_ENVIRONMENT=preprod

# Rôle etare_backup (lit tout, n'écrit que sa trace), via le « Session pooler » :
# pnpm integration roles-sql --only etare_backup (README §3).
BACKUP_DATABASE_URL=postgresql://etare_backup.<project-ref>:<mot-de-passe>@<hôte-pooler>:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/supabase_ca

# Clés publiques age (principale et secours), séparées par une espace. Les clés privées restent hors
# ligne, jamais sur ce serveur : il ne peut pas relire ses propres archives.
BACKUP_AGE_RECIPIENTS=age1… age1…

# Fichiers : Supabase Storage par son protocole S3 (Storage → S3 Configuration : point d'accès, région,
# et une clé d'accès créée pour la sauvegarde).
RCLONE_CONFIG_SOURCE_TYPE=s3
RCLONE_CONFIG_SOURCE_PROVIDER=Other
RCLONE_CONFIG_SOURCE_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
RCLONE_CONFIG_SOURCE_REGION=eu-west-1
RCLONE_CONFIG_SOURCE_ACCESS_KEY_ID=
RCLONE_CONFIG_SOURCE_SECRET_ACCESS_KEY=

# Dépôt hors site : Scaleway Object Storage, Paris, clé d'écriture seule (ObjectStorageObjectsWrite :
# ni lecture, ni liste, ni suppression).
RCLONE_CONFIG_DESTINATION_TYPE=s3
RCLONE_CONFIG_DESTINATION_PROVIDER=Scaleway
RCLONE_CONFIG_DESTINATION_ENDPOINT=s3.fr-par.scw.cloud
RCLONE_CONFIG_DESTINATION_REGION=fr-par
RCLONE_CONFIG_DESTINATION_ACCESS_KEY_ID=SCW…
RCLONE_CONFIG_DESTINATION_SECRET_ACCESS_KEY=
BACKUP_DESTINATION=destination:firescape-preprod-sauvegardes/preprod

# Archives chiffrées gardées sur le serveur (volume de la sauvegarde) : restauration sans téléchargement.
BACKUP_KEEP_LOCAL=2
