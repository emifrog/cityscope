# Configuration du worker de la préproduction. Copier en worker.env sur le serveur (chmod 600).
# APP_ENV, antivirus et clés de signature sont posés par compose.yaml.

# Rôle dédié etare_worker, via le « Session pooler » (pnpm integration roles ou roles-sql, README §3).
WORKER_DATABASE_URL=postgresql://etare_worker.<project-ref>:<mot-de-passe>@<hôte-pooler>:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/supabase_ca

# Stockage des fichiers (contrôle antivirus, miniatures, PDF, fonds de carte).
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=sb_secret_…

DISTRIBUTION_ROOT_KEYS=root:…

# Fonds de carte des tablettes : none (défaut) ou synthetic (fond d'essai, jamais en production).
# BASEMAP_SOURCE=synthetic

# Notifications du portail exploitant (facultatif) : serveur d'envoi et adresse publique du site.
# SMTP_URL=smtps://<utilisateur>:<mot-de-passe>@<serveur>:465
# APP_BASE_URL=https://srv000000.hstgr.cloud
# MAIL_FROM=FireScape préprod <ne-pas-repondre@exemple.fr>

LOG_LEVEL=info
