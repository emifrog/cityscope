# Configuration serveur du web + API de la préproduction. Copier en web.env sur le serveur (chmod 600).
# APP_ENV, clés de signature et relais sont posés par compose.yaml ; ici, ce qui dépend du projet Supabase.

SUPABASE_URL=https://<project-ref>.supabase.co

# Rôle dédié etare_api, via le « Session pooler » (pnpm integration roles ou roles-sql, README §3).
# Certificat du projet monté par compose (secrets/supabase-ca.crt) : connexion vérifiée.
DATABASE_URL=postgresql://etare_api.<project-ref>:<mot-de-passe>@<hôte-pooler>:5432/postgres?sslmode=verify-full&sslrootcert=/run/secrets/supabase_ca

# Clé secrète du projet (Project Settings → API Keys) : URL signées du stockage. Serveur uniquement.
SUPABASE_SECRET_KEY=sb_secret_…

# Clés publiques racines du jeu de clés de la préproduction (root:<id>:<clé>;root:<id>:<clé>).
DISTRIBUTION_ROOT_KEYS=root:…

# Version minimale de l'application OPS (SYN-02).
MOBILE_MIN_APP_VERSION=0.5.0

# Jeton de GET /api/v1/metrics (32 caractères au moins) ; sans lui, pas de métriques.
# METRICS_TOKEN=

LOG_LEVEL=info
