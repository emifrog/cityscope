# Variables lues par docker compose (--env-file infra/preprod/preprod.env). Copier en preprod.env sur le
# serveur ; aucune n'est secrète, mais le fichier réel reste hors du dépôt.

# Adresse publique : nom d'hôte du VPS (hPanel, « srvXXXXXX.hstgr.cloud ») tant qu'il n'y a pas de domaine.
SITE_ADDRESS=srv000000.hstgr.cloud

# Projet Supabase de la préproduction (Project Settings → API) : inscrits dans le code du navigateur.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_…

# Version déployée (journaux, métriques, battement du worker) : posée par deploy.sh (commit court).
APP_VERSION=preprod
