{
  "name": "etare-platform",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @etare/web dev",
    "dev:worker": "pnpm --filter @etare/worker dev",
    "dev:integration": "tsx scripts/with-env.ts .env.integration -- pnpm --filter @etare/web dev",
    "build": "pnpm -r --if-present run build",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:db": "supabase test db",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm contracts:check",
    "db:start": "tsx scripts/ensure-signing-key.ts && supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && tsx scripts/seed-assets.ts",
    "seed:assets": "tsx scripts/seed-assets.ts",
    "db:status": "supabase status",
    "contracts:generate": "tsx scripts/generate-openapi.ts",
    "contracts:check": "tsx scripts/generate-openapi.ts --check",
    "cartography:check": "tsx scripts/check-cartography.ts",
    "brand:assets": "tsx scripts/brand-assets.ts",
    "setup:local": "tsx scripts/setup-local.ts",
    "integration": "tsx scripts/integration.ts",
    "db:push:integration": "supabase db push --linked"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@etare/adapters": "workspace:*",
    "@etare/api": "workspace:*",
    "@etare/application": "workspace:*",
    "@etare/contracts": "workspace:*",
    "@etare/domain": "workspace:*",
    "@etare/worker": "workspace:*",
    "@types/node": "22.20.4",
    "@types/pg": "8.23.1",
    "@vitejs/plugin-react": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "globals": "17.12.0",
    "jsdom": "30.1.1",
    "pg": "8.23.0",
    "prettier": "3.9.9",
    "sharp": "0.35.4",
    "supabase": "2.118.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1",
    "vite": "8.3.1",
    "vitest": "5.0.2"
  }
}
