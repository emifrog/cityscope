# Shared INTEGRATION environment (hosted Supabase project).
# Copy to .env.integration (gitignored) and fill it; never commit the real file.
# Synthetic data only until the hosting region is validated with the SIS (architecture §33).
# Procedure: docs/development.md, "Environnement d'intégration partagé".

APP_ENV=integration

# Browser (publishable by design: a sb_publishable_... key, NEVER a secret key)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# API (server only)
SUPABASE_URL=https://<project-ref>.supabase.co

# Written by `pnpm integration roles` (random passwords, never displayed).
DATABASE_URL=
WORKER_DATABASE_URL=
# Backup job (EXP-02), written by `pnpm integration roles-sql --only etare_backup`: copied to sauvegarde.env.
# BACKUP_DATABASE_URL=
