# Environment variables of etare-platform.
# Local development: do not copy this file by hand, run `pnpm db:start` then `pnpm setup:local`,
# which generates .env.local and apps/web/.env.local from the local Supabase stack.
# Never commit a real .env file. Secrets of shared environments come from a vault at runtime.

APP_ENV=development

# --- Browser (publishable by design: never put a secret in a NEXT_PUBLIC_ variable) ---
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- API (server only) ---
SUPABASE_URL=http://127.0.0.1:54321
# Dedicated least-privileged login (subject to RLS). The app refuses postgres/service roles.
# Local value below is defined in supabase/seed.sql and only valid on the local stack.
DATABASE_URL=postgresql://etare_api:etare_api_local_only@127.0.0.1:54322/postgres
# Optional overrides (derived from SUPABASE_URL by default):
# AUTH_ISSUER=http://127.0.0.1:54321/auth/v1
# AUTH_JWKS_URL=http://127.0.0.1:54321/auth/v1/.well-known/jwks.json
# Storage gateway (API: short-lived signed URLs AFTER authorization; worker: file verification).
# Written by `pnpm setup:local`. Server only: never prefix it with NEXT_PUBLIC_.
# Without it, uploads and downloads answer 503 and the worker does not verify files.
# SUPABASE_SECRET_KEY=

# Offline distribution (ADR-015, SEC-04, ADR-027): Ed25519 key signing the catalogues of the terminals,
# from ONE source: CATALOG_SIGNING_KEY (PKCS#8 DER in base64; development and tests only, refused in
# staging and production), CATALOG_SIGNING_KEY_FILE (secret file mounted by the host, PEM or base64), or
# CATALOG_SIGNING_TRANSIT_KEY (key of a Transit engine of OpenBao or Vault: it never leaves the vault).
# Generated locally by `pnpm setup:local`; procedures: docs/exploitation/cles-de-signature.md.
# CATALOG_SIGNING_KEY=
# CATALOG_SIGNING_KEY_FILE=/run/secrets/catalog_signing_key
# CATALOG_SIGNING_TRANSIT_KEY=etare-catalog
# Oldest OPS application (x.y.z) allowed to install publications (SYN-02), announced in the signed
# catalogues: an older tablet keeps what it has installed and asks for an update. Unset: no minimum.
# MOBILE_MIN_APP_VERSION=0.1.0
# Network protection (SEC-03, ADR-023). Rate limits are on by default ('off' only for automated tests).
# RATE_LIMITS=on
# Trusted reverse proxies in front of the web server (client address taken from X-Forwarded-For, that
# many entries from the right). 0: unknown address, limits per person only. Typically 1 behind a proxy.
# TRUSTED_PROXY_HOPS=0
# Other browser origins allowed to call the API (comma-separated); the own origin is always allowed.
# ALLOWED_ORIGINS=
# Supervision (EXP-03, ADR-028): bearer token of GET /api/v1/metrics (32 characters at least, from a
# vault; Prometheus reads it from a secret file). Unset: no metrics endpoint (404).
# METRICS_TOKEN=
# JSON logs of the API and the worker: debug | info (default) | warn | error. Version of the build,
# in the logs, the metrics and the heartbeat of the worker.
# LOG_LEVEL=info
# APP_VERSION=dev

# --- Signing keys, shared settings of the API and the worker (SEC-04, ADR-027) ---
# Transit engine (OpenBao, Vault): address (https outside development), token file written by the agent
# of the vault (one token per process, its policy limited to its own key), mount and namespace.
# Local: docker run -d --name etare-openbao -p 127.0.0.1:8200:8200 quay.io/openbao/openbao:2.7.1
# SIGNING_TRANSIT_URL=https://bao.internal:8200
# SIGNING_TRANSIT_TOKEN_FILE=/run/openbao/token
# SIGNING_TRANSIT_MOUNT=transit
# SIGNING_TRANSIT_NAMESPACE=
# Key set served to the tablets, signed by the offline root key (`pnpm keys sign`), and the root public
# keys checking it at startup (`root:<id>:<base64>`, separated by ;). Mandatory in staging and production;
# a process refuses to sign with a key the key set does not list as active.
# DISTRIBUTION_KEYSET_FILE=/run/secrets/distribution_keyset.json
# DISTRIBUTION_KEYSET=
# DISTRIBUTION_ROOT_KEYS=root:ed25519-…:…

# --- Offline base maps of the tablets (ADR-024), read by the API and the worker ---
# synthetic: generated test map (default in development and tests, refused in production);
# ign-plan-vector: Plan IGN through the flow agreed with the IGN, used only once its rights sheet is
# signed off (rights approved in the cartography catalogue); none: no base map (default in staging and
# production).
# BASEMAP_SOURCE=synthetic
# Worker only, agreed flow: contact of the operator sent to the IGN, and pace of the requests.
# BASEMAP_CONTACT=sig@sdis.example
# BASEMAP_REQUESTS_PER_SECOND=4

# --- Worker (server only) ---
WORKER_DATABASE_URL=postgresql://etare_worker:etare_worker_local_only@127.0.0.1:54322/postgres
# WORKER_CONCURRENCY=2
# WORKER_LEASE_SECONDS=60
# WORKER_POLL_INTERVAL_MS=1000
# Ed25519 key signing the manifests of publications and base maps (worker only, never given to the
# API), from ONE source like the catalogue key: PUBLICATION_SIGNING_KEY (development and tests only),
# PUBLICATION_SIGNING_KEY_FILE or PUBLICATION_SIGNING_TRANSIT_KEY. Without it, new publications are not
# distributed to terminals. Mandatory in staging and production. After a rotation, the worker re-signs
# the content in force with it (job signatures.renew, every hour).
# PUBLICATION_SIGNING_KEY=
# PUBLICATION_SIGNING_KEY_FILE=/run/secrets/publication_signing_key
# PUBLICATION_SIGNING_TRANSIT_KEY=etare-publication
# ClamAV daemon checking every uploaded file (SEC-01), tcp://host:port. Mandatory in staging and
# production; without it (development only) files are checked for size, SHA-256 and real type only.
# Local: docker run -d --name etare-clamav -p 3311:3310 clamav/clamav:stable
# ANTIVIRUS_URL=tcp://127.0.0.1:3311
# Notifications of the exploitant portal (POR-05): mail server and public address of the web
# application (links). Without them, notifications fail visibly and can be sent again later.
# Local: Mailpit of the Supabase stack (web interface on http://127.0.0.1:54324).
# SMTP_URL=smtp://127.0.0.1:54325
# APP_BASE_URL=http://localhost:3000
# MAIL_FROM=FireScape <ne-pas-repondre@firescape.invalid>

# --- Integration tests only (migration identity, never used by the application) ---
LOCAL_DATABASE_ADMIN_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
